# Application
APP_NAME=service-request-chatbot-api
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/service_request_chatbot

# Redis
REDIS_URL=redis://localhost:6379/0

# External integrations — set these to activate real platform mode (leave blank for mock mode)
# SERVICE_REQUEST_API_BASE_URL  → POST /service-requests, PATCH, GET, PUT /files
# LEASE_TENANT_API_BASE_URL     → GET /leases (separate lease/tenant service)
# FILE_UPLOAD_API_BASE_URL      → Reserved/future use; uploads currently use SERVICE_REQUEST_API_BASE_URL + /files
SERVICE_REQUEST_API_BASE_URL=
LEASE_TENANT_API_BASE_URL=
FILE_UPLOAD_API_BASE_URL=

# Platform service-to-service auth (Cenomi platform login via POST /cenomi-ai/login)
# PLATFORM_AUTH_BASE_URL defaults to SERVICE_REQUEST_API_BASE_URL when blank
PLATFORM_AUTH_BASE_URL=
PLATFORM_INTERNAL_API_TOKEN=
PLATFORM_LOGIN_EMAIL=

# Security (replace in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# RBAC enforcement: false = shadow mode (warn + pass through); true = reject unauthenticated
RBAC_ENFORCE=false

# LLM / AI (required in production)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_CONFIDENCE_THRESHOLD=0.6

# ── RAG / FAQ Hybrid Search ────────────────────────────────────────────────────
# Option A — Standard OpenAI embeddings (default, reuses OPENAI_API_KEY above)
# Only SEARCH_PROVIDER + AZURE_SEARCH_* vars needed; EMBEDDING_PROVIDER can be omitted.
#
# Option B — Azure OpenAI embeddings: set EMBEDDING_PROVIDER=azure_openai and fill AZURE_AI_* vars.
#
# Option C — No RAG: leave all vars below blank; faq_node falls back to static FAQ prompt silently.

# Embedding backend: "openai" (default) | "azure_openai"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional: override the OpenAI-compatible embedding endpoint base URL
EMBEDDING_BASE_URL=

# Search backend: "azure_search" (only current implementation)
SEARCH_PROVIDER=azure_search

# Azure AI Search — required when SEARCH_PROVIDER=azure_search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=cenomi-help-index

# Azure OpenAI embeddings — required only when EMBEDDING_PROVIDER=azure_openai
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-02-15-preview
